/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "treegpt",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-06",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": true,
	"routes": [
		{ "pattern": "forkgpt.app", "custom_domain": true },
		// Attached only for its DNS record and certificate; a Single Redirect
		// rule on the zone sends www to the apex before the Worker runs.
		{ "pattern": "www.forkgpt.app", "custom_domain": true },
	],
	"assets": {
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		// /assets/* must hit the Worker so a missing hashed file is a 404,
		// not the SPA shell. A 200 text/html at a .js URL caches as JavaScript
		// and leaves signed-in users on a blank page (ChatApp never loads).
		"run_worker_first": ["/api/*", "/assets/*"],
	},
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	"secrets": {
		"required": [
			"OPENROUTER_API_KEY",
			"GITHUB_CLIENT_ID",
			"GITHUB_CLIENT_SECRET",
			"BETTER_AUTH_SECRET",
			"GOOGLE_CLIENT_ID",
			"GOOGLE_CLIENT_SECRET",
		],
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "treegpt",
			"database_id": "418e139e-8680-4979-aad2-9a40ed5a9aa6",
			"migrations_dir": "migrations",
		},
	],
}
