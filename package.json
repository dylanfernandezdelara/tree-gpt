{
  "name": "treegpt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run --config vitest.config.ts",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply treegpt --local",
    "db:migrate:remote": "wrangler d1 migrations apply treegpt --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "^1.7.3",
    "border-beam": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.42.0",
    "motion": "^13.2.0",
    "motion-panels": "^0.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "thinking-orbs": "^0.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
